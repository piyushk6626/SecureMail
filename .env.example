# Copy to a local .env if you want a reminder. Nothing in this repository
# auto-loads this file. Export variables in the shell that starts Uvicorn.

# macOS only: lets the uv-managed interpreter find Homebrew Pango/cairo.
DYLD_FALLBACK_LIBRARY_PATH=/opt/homebrew/lib

# Canonical report catalog. Relative paths resolve from the process cwd.
# If set and SECUREMAIL_DATA_ROOT is unset, this also becomes the data root.
# SECUREMAIL_REPORT_ROOT=out/data

# Jobs, quarantine, artifacts, ML history. Required for capture upload.
# SECUREMAIL_DATA_ROOT=out/data

# Exactly 1 starts python -m securemail.worker from FastAPI lifespan.
# Default is 1 when either root is set, else 0. Catalog-only MUST set 0.
# SECUREMAIL_START_WORKER=1

# Upload cap in bytes. Default 67108864 (64 MiB). Invalid values are
# silently replaced with the default during API startup.
# SECUREMAIL_MAX_CAPTURE_BYTES=67108864

# Tests / Playwright only. Exactly 1 skips Docker analysis.
# SECUREMAIL_ANALYSIS_STUB=0

# Frontend Vite proxy target (frontend/.env.local or the shell running npm).
# VITE_API_TARGET=http://127.0.0.1:8000

# CI-only doctor formatting. Not used on workstations.
# SECUREMAIL_CI=0

# Not read. Historical design placeholders — do not expect a database or IdP.
# DATABASE_URL=
# OIDC_ISSUER=
