# macOS only: lets the uv-managed interpreter find Homebrew Pango/cairo at Step 9.
DYLD_FALLBACK_LIBRARY_PATH=/opt/homebrew/lib

# Optional Step 11 read-only canonical-report catalog. Relative paths resolve
# from the process working directory; omit it to start with an empty catalog.
# SECUREMAIL_REPORT_ROOT=tests/fixtures/dashboard

