{
  "name": "securemail-dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "PLAYWRIGHT_HOST_PLATFORM_OVERRIDE=$(node -e \"if(process.platform==='darwin'&&process.arch==='arm64')process.stdout.write('mac26-arm64')\") NODE_PATH=./node_modules playwright test --config playwright.config.ts",
    "generate:types": "json2ts ../src/securemail/domain/reports/canonical_report.schema.json src/types/canonical_report.generated.ts --bannerComment '/* Generated from canonical_report.schema.json. Do not edit. */'"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.2.8",
    "@fontsource-variable/jetbrains-mono": "5.2.8",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-table": "9.2.4",
    "clsx": "2.1.1",
    "echarts": "6.1.0",
    "lucide-react": "0.544.0",
    "motion": "13.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.3.1",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "24.3.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "6.0.1",
    "eslint": "9.35.0",
    "eslint-plugin-react-hooks": "6.0.0-rc.1",
    "eslint-plugin-react-refresh": "0.4.20",
    "globals": "16.3.0",
    "json-schema-to-typescript": "15.0.4",
    "jsdom": "30.0.1",
    "shadcn": "4.21.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vite": "8.2.2",
    "vitest": "5.0.0"
  }
}
